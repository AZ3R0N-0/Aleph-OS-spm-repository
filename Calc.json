{
  "code": [
    "print('--- Calculator ---')",
    "print()",
    "while True:",
    "  try:",
    "    num1 = float(input('First number: '))",
    "    op = input('Operation (+ - * / ** //): ')",
    "    num2 = float(input('Second number: '))",
    "    if op == '+':",
    "      print(f'Result: {num1 + num2}')",
    "    elif op == '-':",
    "      print(f'Result: {num1 - num2}')",
    "    elif op == '*':",
    "      print(f'Result: {num1 * num2}')",
    "    elif op == '/':",
    "      print(f'Result: {num1 / num2}')",
    "    elif op == '**':",
    "      print(f'Result: {num1 ** num2}')",
    "    elif op == '//':",
    "      print(f'Result: {num1 // num2}')",
    "    else:",
    "      raise ValueError('invalid operator')",
    "    print('\\033[2m~\\033[0m')",
    "  except KeyboardInterrupt:",
    "    break"
  ]
}
